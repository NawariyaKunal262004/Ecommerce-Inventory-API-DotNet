# Copy this file to .env and replace every placeholder before running the API.
# Never commit .env.

DATABASE_CONNECTION_STRING=Server=(localdb)\\MSSQLLocalDB;Database=MedicalDB;Trusted_Connection=True;TrustServerCertificate=True;
JWT_KEY=replace-with-a-long-random-signing-key-at-least-32-characters

# Optional development admin seed. Set SEED_ADMIN_ENABLED=false to disable it.
SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-password